{
  "name": "sistema-logistico-backend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node ../scripts/start-test.mjs",
    "build": "tsc -p tsconfig.json --outDir .verification-dist",
    "build:production": "tsc -p tsconfig.json --outDir .release-candidate",
    "start": "node dist/server.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --outDir .test-dist && node --test .test-dist/app.test.js .test-dist/ddtPreview.test.js .test-dist/customerRecognition.test.js .test-dist/definitiveDdt.test.js .test-dist/issuedDdt.test.js .test-dist/historicalTransport.test.js",
    "test:health": "node scripts/check-health.mjs",
    "test:ddt-preview": "tsc -p tsconfig.json --outDir .test-dist && node --test .test-dist/ddtPreview.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.3",
    "typescript": "^7.0.2"
  }
}
